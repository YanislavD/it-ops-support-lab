# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Discord webhook URL used by alertmanager-discord to relay Alertmanager
# notifications into a Discord channel.
# Create one: Discord server -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# osTicket bootstrap (used only on first install; safe to leave defaults for a local demo)
OSTICKET_SECRET_SALT=change-me-to-any-32-char-random-string
OSTICKET_ADMIN_EMAIL=admin@novatech.example
OSTICKET_ADMIN_PASSWORD=changeme123

# API key for the ticket-bridge service to create tickets via osTicket's REST API.
# This CANNOT be set up front - it's generated inside osTicket's admin panel
# (Admin Panel -> Manage -> API Keys -> Add New API Key) after first boot,
# restricted to ticket-bridge's static IP (172.28.0.50). See README Module 4.
OSTICKET_API_KEY=
