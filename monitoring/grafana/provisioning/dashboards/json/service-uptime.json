    {
      "type": "stat",
      "title": "event-app",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_success{service=\"event-app\"}",
          "refId": "A",
