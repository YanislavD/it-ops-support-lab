        {
          "expr": "probe_success{service=\"admin-portal\"}",
          "legendFormat": "admin-portal",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "probe_success{service=\"event-app\"}",
          "legendFormat": "event-app",
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stepped": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
