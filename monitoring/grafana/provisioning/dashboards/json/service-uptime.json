    {
      "type": "timeseries",
      "title": "Response Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_duration_seconds{service=\"corporate-website\"}",
          "legendFormat": "corporate-website",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "probe_duration_seconds{service=\"asset-api\"}",
          "legendFormat": "asset-api",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "probe_duration_seconds{service=\"admin-portal\"}",
          "legendFormat": "admin-portal",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "probe_duration_seconds{service=\"event-app\"}",
          "legendFormat": "event-app",
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Uptime (probe_success)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_success{service=\"corporate-website\"}",
          "legendFormat": "corporate-website",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "probe_success{service=\"asset-api\"}",
          "legendFormat": "asset-api",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
